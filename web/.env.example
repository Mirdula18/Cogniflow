# Copy to .env.local. Never commit .env.local.

# "mock" replays scripted demo scenarios (P3 default).
# "live" talks to the FastAPI backend over REST + SSE.
NEXT_PUBLIC_DATA_MODE=mock

# Base URL of the FastAPI backend, used only in live mode.
# Example: http://localhost:8000 (the api/ stub: `uvicorn main:app --port 8000`).
# Leave empty to call /api on the same origin.
NEXT_PUBLIC_API_BASE_URL=
