   "language": "python",
   "source": "def parse_dates(s):\n    iso = pd.to_datetime(s, format='%Y-%m-%d', errors='coerce')\n    dmy = pd.to_datetime(s, format='%d/%m/%Y', errors='coerce')\n    return iso.fillna(dmy)\n\nbefore = len(df)\ndf = df.drop_duplicates()\nfor col in ['planned_start', 'planned_end', 'actual_end']:\n    df[col] = parse_dates(df[col])\ndf['delay_days'] = (df['actual_end'] - df['planned_end']).dt.days\nprint(f\"Removed {before - len(df)} duplicate rows, {len(df)} tasks left\")\nprint(f\"Dates that could not be read: {int(df[['planned_start', 'planned_end', 'actual_end']].isna().sum().sum())}\")"
  },
