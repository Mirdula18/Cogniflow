   "language": "python",
   "source": "df['month'] = df['planned_end'].dt.to_period('M')\nlast = df[df['month'] == df['month'].max()]\nearlier = df[df['month'] < df['month'].max()]\nby_team = pd.DataFrame({\n    'tasks': last.groupby('team').size(),\n    'avg_delay_last': last.groupby('team')['delay_days'].mean(),\n    'avg_delay_earlier': earlier.groupby('team')['delay_days'].mean(),\n}).round(1).sort_values('avg_delay_last', ascending=False)\nprint(f\"Last month in the data: {df['month'].max()}, {len(last)} tasks\")\nprint(by_team.to_string())\nprint(f\"Average delay: {last['delay_days'].mean():.1f} days last month, {earlier['delay_days'].mean():.1f} days before\")"
  },
