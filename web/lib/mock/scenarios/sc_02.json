   "language": "python",
   "source": "df['order_date'] = pd.to_datetime(df['order_date'])\ndf['quarter'] = df['order_date'].dt.to_period('Q')\nq = df.pivot_table(index='region', columns='quarter', values='revenue', aggfunc='sum')\nq.columns = [str(c) for c in q.columns]\nprev, cur = q.columns[0], q.columns[-1]\nq[[prev, cur]] = q[[prev, cur]].round(0).astype('int64')\nq['change_pct'] = ((q[cur] - q[prev]) / q[prev] * 100).round(1)\nq = q.sort_values('change_pct')\nprint(f\"Comparing {cur} with {prev}\")\nprint(q.to_string())\nprint(f\"Largest fall: {q.index[0]} ({q['change_pct'].iloc[0]}%)\")"
